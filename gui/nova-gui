#!/usr/bin/env python3
"""nova-gui — GTK4/libadwaita frontend for nova (GNOME 40+).

Thin UI layer: all real work is delegated to the `nova` CLI. The app list
comes from `nova list --porcelain --check`; actions stream their output into
the log pane. Root escalation for system apps happens inside nova (pkexec).
"""
import os
import shlex
import shutil
import signal
import subprocess
import threading

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, GLib, GObject  # noqa: E402

APP_ID = "org.novanetwork.NovaUpdater"

STATUS_LABEL = {
    "installed":        ("Installed", "success"),
    "update-available": ("Update available", "warning"),
    "not-installed":    ("Not installed", "dim-label"),
    "unreachable":      ("Remote unreachable", "error"),
}

TYPE_ICON = {
    "cli": "utilities-terminal-symbolic",
    "gui": "application-x-executable-symbolic",
    "cli+gui": "application-x-executable-symbolic",
    "gnome-extension": "application-x-addon-symbolic",
    "system": "emblem-system-symbolic",
}


def find_nova():
    """Locate the nova CLI: PATH, standard install locations, dev checkout."""
    candidates = [
        shutil.which("nova"),
        os.path.expanduser("~/.local/bin/nova"),
        "/usr/local/bin/nova",
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "bin", "nova"),
    ]
    for c in candidates:
        if c and os.path.exists(c):
            return os.path.realpath(c)
    return None


class AppRow(Adw.ActionRow):
    """One selectable app in the list."""

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.set_use_markup(False)
        self.set_title(app["name"])
        if app["desc"]:
            self.set_subtitle(app["desc"])

        self.check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
        self.add_prefix(self.check)
        self.set_activatable_widget(self.check)

        base_typ = app["typ"].split(" ")[0]        # "cli+gui (cli-only)" -> "cli+gui"
        if base_typ in TYPE_ICON:
            icon = Gtk.Image.new_from_icon_name(TYPE_ICON[base_typ])
            icon.set_tooltip_text(app["typ"])
            icon.add_css_class("dim-label")
            self.add_suffix(icon)
        if "(cli-only)" in app["typ"]:
            tag = Gtk.Label(label="cli-only")
            tag.add_css_class("caption")
            tag.add_css_class("dim-label")
            tag.set_tooltip_text("GUI parts were not installed on this machine (headless)")
            self.add_suffix(tag)

        if app["ver"] and app["ver"] != "-":
            ver = Gtk.Label(label=app["ver"])
            ver.add_css_class("numeric")
            ver.add_css_class("dim-label")
            self.add_suffix(ver)

        label, css = STATUS_LABEL.get(app["status"], (app["status"], "dim-label"))
        if app["status"] == "update-available" and app["tref"]:
            label = f"{label} → {app['tref']}"
        status = Gtk.Label(label=label)
        status.add_css_class(css)
        self.add_suffix(status)


class NovaWindow(Adw.ApplicationWindow):
    def __init__(self, app, nova):
        super().__init__(application=app, title="Nova Updater")
        self.nova = nova
        self.busy = False
        self.rows = []
        self.set_default_size(780, 640)

        # ---- header bar ------------------------------------------------
        header = Adw.HeaderBar()
        self.title = Adw.WindowTitle(title="Nova Updater")
        header.set_title_widget(self.title)

        self.btn_refresh = Gtk.Button(icon_name="view-refresh-symbolic",
                                      tooltip_text="Refresh and check for updates")
        self.btn_refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_start(self.btn_refresh)

        self.btn_select = Gtk.Button(label="Select Updates",
                                     tooltip_text="Select every app with an available update")
        self.btn_select.connect("clicked", self.on_select_updates)
        header.pack_start(self.btn_select)

        self.btn_log = Gtk.ToggleButton(icon_name="utilities-terminal-symbolic",
                                        tooltip_text="Show log")
        header.pack_end(self.btn_log)

        # ---- action bar --------------------------------------------------
        self.btn_uninstall = Gtk.Button(label="Uninstall")
        self.btn_uninstall.add_css_class("destructive-action")
        self.btn_uninstall.connect("clicked", self.on_uninstall)

        self.btn_install = Gtk.Button(label="Install / Update")
        self.btn_install.add_css_class("suggested-action")
        self.btn_install.add_css_class("pill")
        self.btn_install.connect("clicked", lambda *_: self.run_action("install"))

        self.spinner = Gtk.Spinner()
        actionbar = Gtk.ActionBar()
        actionbar.pack_start(self.btn_uninstall)
        actionbar.pack_start(self.spinner)
        actionbar.pack_end(self.btn_install)

        # ---- app list / empty state ---------------------------------------
        self.groups_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                                  margin_top=18, margin_bottom=18,
                                  margin_start=12, margin_end=12)
        clamp = Adw.Clamp(maximum_size=760, child=self.groups_box)
        scroll = Gtk.ScrolledWindow(child=clamp, vexpand=True,
                                    hscrollbar_policy=Gtk.PolicyType.NEVER)

        self.empty = Adw.StatusPage(
            icon_name="system-software-install-symbolic",
            title="No Apps Configured",
            description="Add a tool repo with:  <tt>nova add URL</tt>\n"
                        "or register a catalog:  <tt>nova catalog add URL</tt>",
            vexpand=True,
        )

        self.stack = Gtk.Stack()
        self.stack.add_named(scroll, "list")
        self.stack.add_named(self.empty, "empty")

        # ---- log pane -------------------------------------------------------
        self.logbuf = Gtk.TextBuffer()
        logview = Gtk.TextView(buffer=self.logbuf, editable=False, monospace=True,
                               wrap_mode=Gtk.WrapMode.WORD_CHAR,
                               left_margin=8, top_margin=6, bottom_margin=6)
        self.logview = logview
        logscroll = Gtk.ScrolledWindow(child=logview, min_content_height=170)
        logscroll.add_css_class("view")
        self.log_revealer = Gtk.Revealer(child=logscroll,
                                         transition_type=Gtk.RevealerTransitionType.SLIDE_UP)
        self.btn_log.bind_property("active", self.log_revealer, "reveal-child",
                                   GObject.BindingFlags.BIDIRECTIONAL)

        # ---- layout -----------------------------------------------------------
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(self.stack)
        content.append(self.log_revealer)

        self.toasts = Adw.ToastOverlay(child=content)

        view = Adw.ToolbarView(content=self.toasts)
        view.add_top_bar(header)
        view.add_bottom_bar(actionbar)
        self.set_content(view)

        self.refresh()

    # ---- helpers ---------------------------------------------------------
    def set_busy(self, busy, message=""):
        self.busy = busy
        for b in (self.btn_refresh, self.btn_install, self.btn_uninstall, self.btn_select):
            b.set_sensitive(not busy)
        self.title.set_subtitle(message)
        self.spinner.set_spinning(busy)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    def append_log(self, text):
        end = self.logbuf.get_end_iter()
        self.logbuf.insert(end, text)
        mark = self.logbuf.create_mark(None, self.logbuf.get_end_iter(), False)
        self.logview.scroll_mark_onscreen(mark)
        self.logbuf.delete_mark(mark)

    def selected(self):
        """Selected apps as (name, scope, status) — scope matters (the same
        name can exist in both scopes) and status picks install vs update."""
        return [(r.app["name"], r.app["scope"], r.app["status"])
                for r in self.rows if r.check.get_active()]

    def on_select_updates(self, *_):
        for r in self.rows:
            r.check.set_active(r.app["status"] == "update-available")

    # ---- refresh (nova list --porcelain --check) ---------------------------
    def refresh(self):
        if self.busy:
            return
        self.set_busy(True, "Checking for updates…")

        def worker():
            try:
                out = subprocess.run(
                    [self.nova, "list", "--porcelain", "--check"],
                    capture_output=True, text=True, timeout=180,
                ).stdout
            except Exception as e:  # noqa: BLE001
                out = ""
                GLib.idle_add(self.append_log, f"refresh failed: {e}\n")
            GLib.idle_add(self.populate, out)

        threading.Thread(target=worker, daemon=True).start()

    def populate(self, porcelain):
        prev = {r.app["name"]: r.check.get_active() for r in self.rows}
        child = self.groups_box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.groups_box.remove(child)
            child = nxt
        self.rows = []

        apps = []
        for line in porcelain.splitlines():
            p = line.split("\t")
            if len(p) < 7:
                continue
            apps.append(dict(name=p[0], scope=p[1], typ=p[2], status=p[3],
                             ver=p[4], url=p[5], desc=p[6],
                             tref=p[7] if len(p) > 7 else ""))

        updates = 0
        for scope, heading in (("user", "User Apps"), ("system", "System Apps (root)")):
            scoped = [a for a in apps if a["scope"] == scope]
            if not scoped:
                continue
            label = Gtk.Label(label=heading, xalign=0)
            label.add_css_class("heading")
            listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            listbox.add_css_class("boxed-list")
            for a in scoped:
                if a["status"] == "update-available":
                    updates += 1
                row = AppRow(a)
                row.check.set_active(prev.get(a["name"], False))
                listbox.append(row)
                self.rows.append(row)
            self.groups_box.append(label)
            self.groups_box.append(listbox)

        self.stack.set_visible_child_name("list" if apps else "empty")
        msg = f"{len(apps)} apps · {updates} updates available" if apps else ""
        self.set_busy(False, msg)
        return False

    # ---- actions --------------------------------------------------------------
    def on_uninstall(self, *_):
        sel = self.selected()
        if not sel or self.busy:
            if not sel:
                self.toast("Select at least one app first")
            return
        dlg = Adw.AlertDialog(heading=f"Uninstall {len(sel)} app(s)?",
                              body=", ".join(f"{n} ({s})" for n, s, _ in sel))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("remove", "Uninstall")
        dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("cancel")
        dlg.connect("response", lambda _d, r: r == "remove" and self.run_action("uninstall"))
        dlg.present(self)

    def run_action(self, verb):
        if self.busy:
            return
        sel = self.selected()
        if not sel:
            self.toast("Select at least one app first")
            return

        # one command per scope and per real verb. Installed apps get "update"
        # (system updates then run passwordless via the root service); only
        # genuinely new apps get "install" (system installs prompt by design).
        cmds = []
        for scope in ("user", "system"):
            if verb == "uninstall":
                names = [n for n, s, _ in sel if s == scope]
                if names:
                    cmds.append([self.nova, "uninstall", f"--{scope}"] + names)
                continue
            new = [n for n, s, st in sel if s == scope and st == "not-installed"]
            upd = [n for n, s, st in sel if s == scope and st != "not-installed"]
            if new:
                cmds.append([self.nova, "install", f"--{scope}"] + new)
            if upd:
                cmds.append([self.nova, "update", f"--{scope}"] + upd)

        self.btn_log.set_active(True)
        self.set_busy(True, f"Running {verb} for {len(sel)} app(s)…")

        def worker():
            rc = 0
            for cmd in cmds:
                GLib.idle_add(self.append_log,
                              f"\n$ {' '.join(shlex.quote(c) for c in cmd)}\n")
                try:
                    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                            stderr=subprocess.STDOUT, text=True, bufsize=1)
                    for line in proc.stdout:
                        GLib.idle_add(self.append_log, line)
                    rc = proc.wait() or rc
                except Exception as e:  # noqa: BLE001
                    GLib.idle_add(self.append_log, f"error: {e}\n")
                    rc = 1

            def done():
                self.append_log(f"[{verb} finished with exit code {rc}]\n")
                self.set_busy(False)
                self.toast("Done" if rc == 0 else f"{verb} failed (exit {rc}) — see log")
                self.refresh()
                return False

            GLib.idle_add(done)

        threading.Thread(target=worker, daemon=True).start()


class NovaApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            nova = find_nova()
            if not nova:
                d = Adw.AlertDialog(heading="nova CLI not found",
                                    body="Install nova-updater first (install.sh).")
                d.add_response("close", "Close")
                d.connect("response", lambda *_: self.quit())
                tmp = Adw.ApplicationWindow(application=self)
                d.present(tmp)
                return
            win = NovaWindow(self, nova)
        win.present()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    raise SystemExit(NovaApp().run(None))
