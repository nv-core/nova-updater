// nova-updater: let local admin users trigger the system update service
// without a password. The only thing this authorizes is *starting*
// nova-updater-system.service — root then runs its own fixed update code;
// no user-controlled arguments are involved. Installs/uninstalls of system
// apps still require full authentication.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "nova-updater-system.service" &&
        action.lookup("verb") == "start" &&
        subject.isInGroup("wheel") && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
